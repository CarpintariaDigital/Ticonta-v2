# ==============================================================================
# TiConta v2 - Global Environment Variables Template
# ==============================================================================
# Copy this file to .env before running the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & FASTAPI
# ------------------------------------------------------------------------------
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-min-32-chars-secret-key-ticonta
ALGORITHM=HS256
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For PostgreSQL (Recommended for Docker / Production):
DATABASE_URL=postgresql://ticonta_user:ticonta_password@localhost:5432/ticonta_v2

# For Local SQLite Development (Fallback):
# DATABASE_URL=sqlite:///./ticonta.db

# Docker-Compose Database Credentials:
POSTGRES_USER=ticonta_user
POSTGRES_PASSWORD=ticonta_password
POSTGRES_DB=ticonta_v2
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. JWT & SECURITY
# ------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. COMPANY & COMPLIANCE (MOZAMBIQUE)
# ------------------------------------------------------------------------------
COMPANY_NAME=Empresa de Demonstração Lda
COMPANY_NUIT=400123456
COMPANY_CITY=Maputo
COMPANY_COUNTRY=Moçambique
DEFAULT_CURRENCY=MZN
STANDARD_VAT_RATE=16.0

# ------------------------------------------------------------------------------
# 5. LICENSING SYSTEM (HMAC-SHA256)
# ------------------------------------------------------------------------------
LICENSE_MASTER_KEY=change-me-in-production-min-32-chars-master-key
LICENSE_COMPANY_ID=TIC-MZ-001

# ------------------------------------------------------------------------------
# 6. DOCUMENT DELIVERY (WHATSAPP & SMS - TWILIO / PREMIUM)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+15005550006

# ------------------------------------------------------------------------------
# 7. EMAIL & SMTP (NOTIFICATIONS & DIGITAL RECEIPTS)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
EMAIL_USERNAME=notifications@ticonta.co.mz
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="TiConta ERP <notifications@ticonta.co.mz>"

# ------------------------------------------------------------------------------
# 8. CLOUD STORAGE (PDF RETENTION / CDN)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=mock
# Options: mock, s3, r2
CLOUDFLARE_R2_BUCKET=ticonta-documents
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
STORAGE_PUBLIC_BASE_URL=https://documents.ticonta.co.mz

# ------------------------------------------------------------------------------
# 9. FRONTEND PUBLIC ENVIRONMENT VARIABLES (NEXT.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TiConta v2
NEXT_PUBLIC_DEFAULT_LANGUAGE=pt
