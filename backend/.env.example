# TiConta v2 Environment Configuration Template

PROJECT_NAME="TiConta v2 ERP"
ENVIRONMENT=dev

# Security
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY=supersecretkeychangeinproduction1234567890abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# JSON list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Connection
# PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticonta_v2
# For local fallback development: sqlite:///./ticonta_v2.db
