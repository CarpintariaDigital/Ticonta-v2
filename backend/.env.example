# FastAPI
DEBUG=True
SECRET_KEY=change-me-in-production-very-secret-key-here
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ticonta_dev
# Para desenvolvimento local: sqlite:///ticonta.db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO

# Email (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Compliance
ENVIRONMENT=development
COMPANY_NUIT=123456789
