# FastAPI
DEBUG=True
SECRET_KEY=change-me-in-production-very-secret-key-here
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ticonta_dev
# Para desenvolvimento local: sqlite:///ticonta.db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO

# Email (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Compliance
ENVIRONMENT=development
COMPANY_NUIT=123456789

# Licensing System (HMAC-SHA256)
LICENSE_MASTER_KEY=change-me-in-production-min-32-chars-master-key
LICENSE_COMPANY_ID=TIC-MZ-001

# Document Delivery (Twilio WhatsApp & SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+15005550006

# Cloud Storage (Temporary 24-48h PDFs)
STORAGE_PROVIDER=mock
CLOUDFLARE_R2_BUCKET=ticonta-documents
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
STORAGE_PUBLIC_BASE_URL=https://documents.ticonta.co.mz
